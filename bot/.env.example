# ── Claude (https://platform.claude.com → API keys) ──
ANTHROPIC_API_KEY=sk-ant-...
# Модель: claude-haiku-5-5 (арзан, әдепкі) немесе claude-opus-5-5 (ақылдырақ, ~50 есе қымбат)
# Ойлау деңгейі: low / medium / high
BOT_MODEL=claude-haiku-5-5
BOT_EFFORT=low

# ── Telegram бот (@BotFather → /newbot) ──
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Сіздің Telegram ID-іңіз. Білмесеңіз бос қалдырып, ботқа /id деп жазыңыз.
OWNER_CHAT_ID=

# ── Gmail (Google аккаунт → Қауіпсіздік → 2 қадамды растау → App passwords) ──
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Mail.ru (Настройки → Безопасность → Пароли для внешних приложений) ──
MAILRU_ADDRESS=
MAILRU_APP_PASSWORD=

# Поштаны неше секунд сайын тексеру
MAIL_POLL_SECONDS=60
